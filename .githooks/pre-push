#!/usr/bin/env sh
# Privacy guard on the commits being pushed, before anything leaves this machine.
# git passes the remote name and url as arguments and the ref lines on stdin;
# scripts/package_source.py --pre-push scans every file version those commits
# introduce (including files added and deleted again inside the range).
# Installed by start.sh / Start-InvoiceStudio.ps1 on first run from a clone, or
# by hand once per clone:  git config core.hooksPath .githooks
# Limits: local and bypassable (git push --no-verify); nothing already on the
# remote is inspected; the CI workflow (whole tree) runs after publication.
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -x .venv/bin/python ]; then PY=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe
elif command -v python3 >/dev/null 2>&1; then PY=python3
elif command -v python >/dev/null 2>&1; then PY=python
else
    echo "pre-push privacy guard: no Python interpreter found. Install python3 (3.11 or newer) or create the project venv (.venv), then push again. The push was refused." >&2
    exit 1
fi
exec "$PY" scripts/package_source.py --pre-push "${1:-origin}"
