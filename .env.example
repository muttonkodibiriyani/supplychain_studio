# Use a different Compose project and port for each brand.
# Project name determines the persistent data volume. Keep it stable on upgrades.
COMPOSE_PROJECT_NAME=invoice-studio
INVOICE_HOST_PORT=8000
INVOICE_MAX_FILE_BYTES=67108864
# Rasterisation bounds for scanned pages. A page above the per-page bound, or
# a document above the total bound, fails whole; nothing is truncated. A PDF
# page rasterises at 2 px per point; an image upload counts its own pixels.
INVOICE_MAX_PIXELS_PER_PAGE=30000000
INVOICE_MAX_TOTAL_PIXELS=150000000

# Parallel extraction workers. Raise toward your CPU core count for large
# batches; OCR-heavy invoices are the slow path. 8 cores -> try 8.
INVOICE_WORKERS=4
# Values above 2 x CPU cores are cut to that limit (logged at startup).

# Worker pool health. /api/health reports status "degraded" (with a
# "problems" list) when fewer workers than configured are alive or when
# uploads sit queued with no worker activity for INVOICE_WORKER_STALL_SECONDS.
# INVOICE_DB_BUSY_TIMEOUT_SECONDS is how long a write waits for the SQLite lock.
INVOICE_WORKER_STALL_SECONDS=120
INVOICE_DB_BUSY_TIMEOUT_SECONDS=30

# POST /api/demo seeds fictional catalog rows and invoices for training. It is
# off by default and, when enabled, refuses to run on a database that already
# holds real rows. Leave it off for every brand workspace.
INVOICE_ENABLE_DEMO_SEED=false
